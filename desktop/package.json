{
  "name": "rag-vault-studio",
  "productName": "RAG Vault Studio",
  "version": "0.1.0",
  "description": "Workspace OS – local RAG vaults for Windows 11",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "app": "electron .",
    "app:dev": "cross-env WSOS_DEV_URL=http://localhost:5173 electron .",
    "typecheck": "tsc --noEmit",
    "test:main": "node --test electron/openable.test.cjs"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.56.0",
    "@fluentui/react-icons": "^2.0.265",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
